diff --git a/patch_cirrus/patch_cirrus_a1534_pcm.h b/patch_cirrus/patch_cirrus_a1534_pcm.h
index 452f420..d7a2dd7 100644
--- a/patch_cirrus/patch_cirrus_a1534_pcm.h
+++ b/patch_cirrus/patch_cirrus_a1534_pcm.h
@@ -403,30 +403,67 @@ static void cs_4208_free_explicit(struct hda_codec *codec)
 
 static int cs_4208_resume(struct hda_codec *codec)
 {
+	struct hda_cvt_setup *p;
+	unsigned int event = codec->core.dev.power.power_state.event;
+	bool system_resume = event != PM_EVENT_ON;
+	hda_nid_t nid;
+	int hp;
 	int err;
 
-	/* The A1534 speaker amplifiers behind vendor widget 0x24 lose their
-	 * configuration across a system sleep.  With no .resume callback the
-	 * core only re-runs init + regmap sync, which restores the codec but
-	 * not the amps, leaving the speakers silent until the next module
-	 * probe (i.e. reboot).  Replay the probe-time amp bring-up first,
-	 * mirroring the boot order of cs4208_probe().
-	 *
-	 * Runtime resume from power_save idle does not drop amp power, so
-	 * skip the ~1000-verb replay there: power_state is PMSG_ON during a
-	 * plain runtime resume and PMSG_RESUME/RESTORE after S3/S4 (also for
-	 * a deferred first wake after sleep, via hda_codec_pm_complete()). */
-	if (codec->core.dev.power.power_state.event != PM_EVENT_ON) {
-		setup_a1534(codec);
-		play_a1534(codec);
-	}
-
 	err = cs_4208_init_explicit(codec);
 	if (err < 0)
 		return err;
 
 	snd_hda_regmap_sync(codec);
+	if (!system_resume)
+		return 0;
+
+	/* TEST PATCH: restore the board after generic init/cache restoration,
+	 * so neither can overwrite the replay. Keep ordinary runtime wake light.
+	 * This uses only the existing board sequences, not a new verb dump.
+	 * The HDA core sets PMSG_RESUME before system resume and PMSG_ON only
+	 * after this callback; deferred resume is handled by its complete hook.
+	 */
+	codec_info(codec, "Silverletter CS4208 resume-order-v1: begin event=%u tag=%u\n",
+		   event, cs4208_cur_stream_tag);
+	err = setup_a1534(codec);
+	if (err < 0)
+		goto failed;
+
+	hp = snd_hda_jack_detect(codec, 0x10);
+	err = hp ? headphones_a1534(codec) : play_a1534(codec);
+	if (err < 0)
+		goto failed;
+	cs4208_cur_hp = hp;
+	if (hp)
+		snd_hda_codec_write(codec, 0x1d, 0,
+				    AC_VERB_SET_PIN_WIDGET_CONTROL, 0x00);
+
+	/* The board speaker pin 0x1d is connected to digital converter 0x0a,
+	 * not the generic analog converter 0x04. Replay contains fixed stream
+	 * parameters; override them with the live values when a stream exists.
+	 * Later PCM prepare still owns normal stream (re)start.
+	 */
+	nid = hp ? 0x02 : 0x0a;
+	if (cs4208_cur_stream_tag) {
+		p = get_hda_cvt_setup_4208(codec, nid);
+		if (!p) {
+			err = -ENOMEM;
+			goto failed;
+		}
+		p->stream_tag = 0;
+		p->channel_id = 0;
+		p->format_id = 0;
+		snd_hda_codec_setup_stream(codec, nid, cs4208_cur_stream_tag, 0,
+					   cs4208_cur_format);
+	}
+	codec_info(codec, "Silverletter CS4208 resume-order-v1: complete hp=%d nid=0x%02x\n",
+		   hp, nid);
 	return 0;
+
+failed:
+	codec_err(codec, "Silverletter CS4208 resume-order-v1: failed %d\n", err);
+	return err;
 }
 
 // real def is CONFIG_PM
